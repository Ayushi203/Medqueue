# Copy this file to local-secrets.properties (same folder) and fill in your values.
# local-secrets.properties is ignored by git. Environment variables override it:
# MEDQUEUE_DB_USERNAME, MEDQUEUE_DB_PASSWORD, MEDQUEUE_JWT_SECRET,
# MEDQUEUE_ADMIN_EMAIL, MEDQUEUE_ADMIN_PASSWORD
local.db-username=root
local.db-password=change-me
# At least 32 characters
local.jwt-secret=replace-with-a-long-random-secret-of-32-plus-chars
local.admin-email=superadmin@medqueue.com
local.admin-password=change-me
